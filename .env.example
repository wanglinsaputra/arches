# ── R4 Coder Auto Key Generator ─────────────────────────────

# Account password used for every created R4 Coder account
# (can also be passed with --password)
# R4_PASSWORD=WangLinS2026!

# ── Temp mail providers ─────────────────────────────────────
# Comma-separated list, rotated round-robin with fallback.
# Supported: mail.tm, zoromail, ncaori, guerrillamail, yopmail, dropmail,
#            1secemail, tempmail.lol, tempmailc, temp-mail.io, tempmail.plus,
#            emailfake, generator.email, mailnesia, 10minutemail, email-temp
# TEMPMAIL_PROVIDER=mail.tm,zoromail

# ── 9Router integration (optional) ─────────────────────────
# Enable auto-add of generated keys to the 9Router "OpenAI Compatible" provider.
# Integration is DISABLED when either variable is missing.

# 9Router base URL (e.g. http://172.22.144.1:20128)
ROUTER9_URL=

# 9Router admin password (never committed, never logged)
ROUTER9_PASS=
